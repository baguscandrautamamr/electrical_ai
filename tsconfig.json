{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    // Relative imports carry the emitted `.js` extension, not `.ts`. Vercel's
    // function builder transpiles each file and leaves specifiers untouched, so
    // a `.ts` specifier survives into the bundle and the function dies at
    // import with ERR_MODULE_NOT_FOUND. allowImportingTsExtensions would hide
    // that from the typechecker, which is why it is deliberately absent.
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "api/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "revit-addin"]
}
