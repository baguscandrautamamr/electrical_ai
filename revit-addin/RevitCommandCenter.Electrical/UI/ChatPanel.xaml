<UserControl x:Class="RevitCommandCenter.Electrical.UI.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             MinWidth="320">
  <Grid>
    <!--
      Dua lapis, dan hanya satu yang terlihat sekaligus. Panel yang gagal memuat
      apa pun tidak boleh tampil sebagai kotak putih: kotak putih tidak bisa
      dibedakan dari panel yang rusak, sementara yang kurang biasanya satu baris
      di config.json atau satu runtime yang belum terpasang.
    -->
    <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />

    <Border x:Name="Notice"
            Background="#FFFDFDFD"
            Padding="20"
            VerticalAlignment="Stretch">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="NoticeTitle"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Text="Memuat…" />
        <TextBlock x:Name="NoticeBody"
                   FontSize="12"
                   Foreground="#FF555555"
                   TextWrapping="Wrap"
                   LineHeight="18" />
        <Button x:Name="RetryButton"
                Content="Coba lagi"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                Padding="12,4"
                Margin="0,14,0,0"
                Click="OnRetryClick" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
