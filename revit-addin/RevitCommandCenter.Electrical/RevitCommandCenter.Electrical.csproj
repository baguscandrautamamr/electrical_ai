<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2025 hosts .NET 8 on Windows. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RevitCommandCenter.Electrical</AssemblyName>
    <RootNamespace>RevitCommandCenter.Electrical</RootNamespace>
    <Configurations>Debug;Release</Configurations>
    <!-- Revit loads add-ins into its own AppDomain; never copy the Revit API
         assemblies next to our DLL or Revit will load them twice. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Revit API: the local install when there is one, NuGet reference
       assemblies otherwise.

       A machine with Revit 2025 builds against the real DLLs, unchanged. CI has
       no Revit install, so it falls back to Nice3point's published reference
       assemblies — same public surface, no runtime code. Force either side with
       -p:UseRevitNuGet=true|false.

       Point RevitApiDir at your install if it is not on the default path:
       dotnet build -p:RevitApiDir="D:\Autodesk\Revit 2025" -->
  <PropertyGroup>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">C:\Program Files\Autodesk\Revit 2025</RevitApiDir>
    <UseRevitNuGet Condition="'$(UseRevitNuGet)' == '' AND !Exists('$(RevitApiDir)\RevitAPI.dll')">true</UseRevitNuGet>
    <UseRevitNuGet Condition="'$(UseRevitNuGet)' == ''">false</UseRevitNuGet>
    <RevitApiVersion>2025.4.50</RevitApiVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseRevitNuGet)' == 'true'">
    <!-- ExcludeAssets=runtime keeps these out of the output: Revit supplies the
         real assemblies at load time and must not find a second copy. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseRevitNuGet)' != 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Non-commercial licence; switch to a commercial licence before shipping. -->
    <PackageReference Include="EPPlus" Version="7.5.2" />
    <PackageReference Include="itext7" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RevitCommandCenter.Electrical.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\translations\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
