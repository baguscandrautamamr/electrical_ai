# =============================================================
# Revit Electrical Command Center - environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# On Vercel: Settings -> Environment Variables (per Production/Preview/Development).
# =============================================================

# --- Anthropic Claude API (natural language command parsing) ---
# Get from https://console.anthropic.com/, or from your gateway's dashboard
# when ANTHROPIC_BASE_URL below points at one.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5
ANTHROPIC_MODEL=
# Optional. Leave blank to call Anthropic directly. Set it to an
# Anthropic-compatible gateway to bill through a reseller, e.g.
# https://gateway.example.com/anthropic — the key must be that gateway's.
# A gateway key sent to api.anthropic.com comes back "invalid x-api-key",
# which looks like a bad key rather than a request sent to the wrong host.
ANTHROPIC_BASE_URL=

# --- Telegram Bot (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Shared secret echoed by Telegram in X-Telegram-Bot-Api-Secret-Token.
# Set it when registering the webhook so only Telegram can call the endpoint.
TELEGRAM_WEBHOOK_SECRET=

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=
# anon key: safe for RLS-protected client use
SUPABASE_ANON_KEY=
# service role key: SERVER ONLY. Never expose to a browser or the Revit add-in.
SUPABASE_SERVICE_ROLE_KEY=

# --- Internal ---
# Bearer secret required by /api/cron/* endpoints
CRON_SECRET=
# Seconds between Revit add-in polls of commands_queue
POLLING_INTERVAL_SECONDS=4
# Attempts before a command is marked permanently failed
MAX_COMMAND_RETRY=3
# Seconds before a command stuck in 'processing' is reclaimed
COMMAND_TIMEOUT_SECONDS=120
